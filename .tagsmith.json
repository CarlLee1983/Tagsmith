{
  "$schema": "./schema.json",
  "pattern": "v{version}",
  "model": {
    "type": "semver",
    "allowPrerelease": true
  },
  "initialVersion": "0.1.0",
  "push": false,
  "mergePolicy": {
    "protectedBranches": {
      "main": {
        "allow": [
          "feat/*",
          "fix/*",
          "docs/*",
          "chore/*",
          "refactor/*",
          "perf/*",
          "test/*",
          "style/*",
          "ci/*"
        ]
      }
    },
    "onUnknownSource": "block"
  }
}
