{
  "name": "@carllee1983/tagsmith",
  "version": "0.6.0",
  "description": "Define git tag specs, view tags, and generate the next git tag safely — avoiding ordering or format anomalies.",
  "type": "module",
  "publishConfig": { "access": "public" },
  "bin": {
    "tagsmith": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schema.json",
    "json-output.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "tag",
    "semver",
    "calver",
    "cli",
    "release",
    "versioning"
  ],
  "license": "MIT",
  "author": "carl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlLee1983/Tagsmith.git"
  },
  "homepage": "https://github.com/CarlLee1983/Tagsmith#readme",
  "bugs": {
    "url": "https://github.com/CarlLee1983/Tagsmith/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "picocolors": "^1.0.1",
    "semver": "^7.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "^2.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
