{
  "$schema": "https://unpkg.com/@carllee1983/docsentry@0.8.0/schema.json",
  "documents": [
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "package": {
    "manifest": "package.json",
    "assertions": [
      {
        "document": "README.md",
        "label": "published package name",
        "value": "@carllee1983/tagsmith",
        "evidence": "/name"
      },
      {
        "document": "README.md",
        "label": "minimum Node version",
        "value": ">=22",
        "evidence": "/engines/node"
      }
    ]
  },
  "schemaExamples": [
    {
      "documents": [
        "README.md",
        "docs/README.zh-TW.md"
      ],
      "language": "json",
      "schema": "schema.json",
      "fenceLabel": "tagsmith-config"
    }
  ],
  "actionExamples": [
    {
      "documents": [
        "README.md",
        "docs/README.zh-TW.md"
      ],
      "action": "action.yml"
    }
  ],
  "pathReferences": [
    {
      "documents": [
        "README.md",
        "CONTRIBUTING.md",
        "docs/*.md"
      ],
      "include": [
        "src/**",
        "tests/**",
        "docs/**",
        ".github/**",
        "*.json",
        "*.yml",
        "*.md"
      ]
    }
  ],
  "enumerations": [
    {
      "documents": [
        "README.md"
      ],
      "label": "diagnostic code",
      "values": {
        "manifest": "json-output.schema.json",
        "pointer": [
          "/definitions/diagnosticCode/enum",
          "/definitions/auditData/oneOf/1/properties/releaseReadiness/properties/checks/items/properties/code/enum"
        ]
      },
      "documented": {
        "pattern": "[a-z][a-z0-9-]+",
        "section": "Diagnostic codes"
      }
    }
  ]
}
