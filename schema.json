{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CarlLee1983/Tagsmith/schema.json",
  "title": "Tagsmith config",
  "description": "Tag specification for the tagsmith CLI (.tagsmith.json).",
  "oneOf": [
    {
      "title": "Multi-line configuration",
      "type": "object",
      "required": ["tags"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/tagLine" }
        },
        "default": {
          "type": "string",
          "description": "Default tag-line name; defaults to the first line."
        },
        "mergePolicy": { "$ref": "#/definitions/mergePolicy" },
        "releasePolicy": { "$ref": "#/definitions/releasePolicy" }
      }
    },
    {
      "title": "Legacy single-line configuration",
      "type": "object",
      "required": ["pattern", "model", "initialVersion"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "pattern": { "$ref": "#/definitions/pattern" },
        "model": { "$ref": "#/definitions/model" },
        "initialVersion": {
          "type": "string",
          "description": "Version used when no conforming tag exists yet."
        },
        "push": {
          "type": "boolean",
          "description": "Default push behaviour for `tagsmith create`."
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            { "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/]).+" },
            { "not": { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" } }
          ],
          "description": "Repository-relative workspace path for --require-changes."
        },
        "mergePolicy": { "$ref": "#/definitions/mergePolicy" },
        "releasePolicy": { "$ref": "#/definitions/releasePolicy" }
      }
    }
  ],
  "definitions": {
    "pattern": {
      "type": "string",
      "description": "Tag template; must contain the {version} placeholder.",
      "pattern": "\\{version\\}"
    },
    "model": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "semver" },
            "allowPrerelease": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["type", "format"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "calver" },
            "format": {
              "type": "string",
              "description": "Token sequence using YYYY YY MM DD MICRO, e.g. YYYY.MM.MICRO."
            }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "build" },
            "padding": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "tagLine": {
      "type": "object",
      "required": ["name", "pattern", "model", "initialVersion"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Unique line name, used by --tag."
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            { "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/]).+" },
            { "not": { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" } }
          ],
          "description": "Repository-relative workspace path for --require-changes."
        },
        "pattern": { "$ref": "#/definitions/pattern" },
        "model": { "$ref": "#/definitions/model" },
        "initialVersion": {
          "type": "string",
          "description": "Version used when no conforming tag exists yet."
        },
        "push": {
          "type": "boolean",
          "description": "Default push behaviour for `tagsmith create`."
        }
      }
    },
    "mergePolicy": {
      "type": "object",
      "description": "Optional branch merge guardrails enforced by `tagsmith merge-check` via git hooks.",
      "additionalProperties": false,
      "required": ["protectedBranches"],
      "properties": {
        "protectedBranches": {
          "type": "object",
          "description": "Map of protected branch name -> merge rule. Only the current branch is checked; others pass.",
          "additionalProperties": {
            "type": "object",
            "description": "Set exactly one of allow (whitelist) or deny (blacklist). Sources support glob (* and ?).",
            "additionalProperties": false,
            "oneOf": [{ "required": ["allow"] }, { "required": ["deny"] }],
            "properties": {
              "allow": {
                "type": "array",
                "description": "Only these sources may merge in; all others are blocked.",
                "items": { "type": "string", "minLength": 1 }
              },
              "deny": {
                "type": "array",
                "description": "These sources are blocked; all others pass.",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "onUnknownSource": {
          "enum": ["block", "allow"],
          "default": "block",
          "description": "Behaviour when the merge source branch cannot be resolved."
        }
      }
    },
    "releasePolicy": {
      "type": "object",
      "description": "Optional local release readiness guardrails. They are enforced only by `tagsmith create --enforce-policy`.",
      "additionalProperties": false,
      "properties": {
        "allowedBranches": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Branch patterns allowed to create a release. Supports * and ? globs."
        },
        "requireCleanWorktree": {
          "type": "boolean",
          "default": false,
          "description": "Require no staged, unstaged, or untracked files."
        },
        "requireAnnotatedTag": {
          "type": "boolean",
          "default": false,
          "description": "Require the candidate to be an annotated tag."
        },
        "requireHeadTag": {
          "type": "boolean",
          "default": false,
          "description": "Require the candidate tag target to equal HEAD."
        },
        "signature": {
          "enum": ["optional", "required"],
          "default": "optional",
          "description": "Whether create must request a signed tag from Git."
        }
      }
    }
  }
}
